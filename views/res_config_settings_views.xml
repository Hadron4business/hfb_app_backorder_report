<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_backorder_report" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.backorder.report</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='operations_setting_container']" position="inside">
                <setting id="backorder_report" company_dependent="1"
                         help="E-mail customers on a schedule the list of products not delivered yet">
                    <field name="backorder_report"/>
                    <div class="mt8" invisible="not backorder_report">
                        <button name="action_open_backorder_cron" type="object" icon="oi-arrow-right"
                                string="Schedule" class="btn-link"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
