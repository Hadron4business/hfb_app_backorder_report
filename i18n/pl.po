#. module: hfb_app_backorder_report
#: model:mail.template,body_html:hfb_app_backorder_report.mail_template_backorder_report
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Dear <t t-out=\"object.name or ''\">customer</t>,</p>\n"
"    <t t-set=\"lines\" t-value=\"object.get_backorder_report_lines()\"/>\n"
"    <p>Here is the list of products ordered from us that have not been delivered yet:</p>\n"
"    <table style=\"border-collapse: collapse; width: 100%;\">\n"
"        <tr style=\"background-color: #f2f2f2;\">\n"
"            <th style=\"text-align: left; padding: 6px; border-bottom: 1px solid #ddd;\">Order</th>\n"
"            <th style=\"text-align: left; padding: 6px; border-bottom: 1px solid #ddd;\">Product</th>\n"
"            <th style=\"text-align: right; padding: 6px; border-bottom: 1px solid #ddd;\">Quantity</th>\n"
"            <th style=\"text-align: left; padding: 6px; border-bottom: 1px solid #ddd;\">Planned Date</th>\n"
"            <th style=\"text-align: left; padding: 6px; border-bottom: 1px solid #ddd;\">Status</th>\n"
"        </tr>\n"
"        <t t-foreach=\"lines\" t-as=\"line\">\n"
"            <tr>\n"
"                <td style=\"padding: 6px; border-bottom: 1px solid #eee;\" t-out=\"line['order']\">S00001</td>\n"
"                <td style=\"padding: 6px; border-bottom: 1px solid #eee;\" t-out=\"line['product']\">Product</td>\n"
"                <td style=\"padding: 6px; border-bottom: 1px solid #eee; text-align: right;\"><t t-out=\"line['qty']\">1</t> <t t-out=\"line['uom']\">Units</t></td>\n"
"                <td style=\"padding: 6px; border-bottom: 1px solid #eee;\" t-out=\"format_date(line['date'])\">2026-10-01</td>\n"
"                <td style=\"padding: 6px; border-bottom: 1px solid #eee;\" t-out=\"line['status']\">Waiting for stock</td>\n"
"            </tr>\n"
"        </t>\n"
"    </table>\n"
"    <p>Planned dates may change. If you have any question, please contact your salesperson.</p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Dzień dobry, <t t-out=\"object.name or ''\">customer</t>,</p>\n"
"    <t t-set=\"lines\" t-value=\"object.get_backorder_report_lines()\"/>\n"
"    <p>Poniżej lista zamówionych u nas produktów, które nie zostały jeszcze wydane:</p>\n"
"    <table style=\"border-collapse: collapse; width: 100%;\">\n"
"        <tr style=\"background-color: #f2f2f2;\">\n"
"            <th style=\"text-align: left; padding: 6px; border-bottom: 1px solid #ddd;\">Zamówienie</th>\n"
"            <th style=\"text-align: left; padding: 6px; border-bottom: 1px solid #ddd;\">Produkt</th>\n"
"            <th style=\"text-align: right; padding: 6px; border-bottom: 1px solid #ddd;\">Ilość</th>\n"
"            <th style=\"text-align: left; padding: 6px; border-bottom: 1px solid #ddd;\">Planowana data</th>\n"
"            <th style=\"text-align: left; padding: 6px; border-bottom: 1px solid #ddd;\">Status</th>\n"
"        </tr>\n"
"        <t t-foreach=\"lines\" t-as=\"line\">\n"
"            <tr>\n"
"                <td style=\"padding: 6px; border-bottom: 1px solid #eee;\" t-out=\"line['order']\">S00001</td>\n"
"                <td style=\"padding: 6px; border-bottom: 1px solid #eee;\" t-out=\"line['product']\">Product</td>\n"
"                <td style=\"padding: 6px; border-bottom: 1px solid #eee; text-align: right;\"><t t-out=\"line['qty']\">1</t> <t t-out=\"line['uom']\">Units</t></td>\n"
"                <td style=\"padding: 6px; border-bottom: 1px solid #eee;\" t-out=\"format_date(line['date'])\">2026-10-01</td>\n"
"                <td style=\"padding: 6px; border-bottom: 1px solid #eee;\" t-out=\"line['status']\">Waiting for stock</td>\n"
"            </tr>\n"
"        </t>\n"
"    </table>\n"
"    <p>Planowane daty mogą się zmienić. W razie pytań prosimy o kontakt z opiekunem handlowym.</p>\n"
"</div>\n"
"            "

