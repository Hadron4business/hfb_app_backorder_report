<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_backorder_report" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.backorder.report</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <group name="misc" position="inside">
                <field name="backorder_report_optout" invisible="parent_id"/>
            </group>
        </field>
    </record>

    <record id="action_send_backorder_report" model="ir.actions.server">
        <field name="name">Send Backorder Report</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = record.action_send_backorder_report()</field>
    </record>

</odoo>
